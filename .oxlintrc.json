{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "vitest"],
  "ignorePatterns": ["**/routeTree.gen.ts", "**/env.d.ts", "**/mockServiceWorker.js", "**/dist/**", "**/dist-serve/**", "**/dist-e2e/**", "**/storybook-static/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["**/routes/**/*.tsx", "**/*.stories.tsx", "**/.storybook/**"],
      "rules": { "react/only-export-components": "off" }
    }
  ]
}
