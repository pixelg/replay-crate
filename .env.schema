# Every config value for the monorepo is declared here, so there is exactly one
# file to fill in: .env.local next to this one (gitignored via *.local).
# Apps pull what they need with @import(../../, pick=[...]).
#
# @defaultRequired=infer
# @defaultSensitive=true
# ---

# Client ID of the Spotify app (developer.spotify.com/dashboard).
# Public by design: PKCE needs no client secret, so don't add one.
# @sensitive=false @required
SPOTIFY_CLIENT_ID=

# Must exactly match a Redirect URI registered on the Spotify app. Spotify rejects `localhost`.
# @sensitive=false @type=url
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Postgres connection string. The default is the local Docker database from compose.yaml
# (`pnpm db:up`). A *.neon.tech URL switches to Neon's serverless driver, for deploys.
# @type=url @required
DATABASE_URL=postgres://replay:replay@127.0.0.1:54320/replay_crate

# AES-256-GCM key (32 bytes, base64) for encrypting Spotify tokens at rest.
# Generate with: openssl rand -base64 32
# @required
TOKEN_ENCRYPTION_KEY=

# Bearer token the scheduled GitHub Action sends to POST /api/v1/system/cron/poll. Needed from M2.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Last.fm API key (last.fm/api/account/create). Needed from M4.
LASTFM_API_KEY=
