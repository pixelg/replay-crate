{
  "name": "replay-crate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm db:up && turbo run dev --filter=@replay-crate/web --filter=@replay-crate/api",
    "db:up": "docker compose up --detach --wait",
    "db:down": "docker compose stop",
    "db:migrate": "pnpm --filter @replay-crate/db db:migrate",
    "db:psql": "docker compose exec postgres psql -U replay replay_crate",
    "build": "turbo run build",
    "lint": "oxlint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "pnpm --filter @replay-crate/web storybook",
    "build-storybook": "turbo run build-storybook",
    "serve": "./scripts/serve.sh",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "turbo": "^2.11.4",
    "typescript": "~6.0.2"
  }
}
