# API config. Values come from the root .env.local; see the root .env.schema for docs.
#
# @import(../../, pick=[SPOTIFY_CLIENT_ID, SPOTIFY_REDIRECT_URI, DATABASE_URL, TOKEN_ENCRYPTION_KEY, CRON_SECRET, LASTFM_API_KEY, ELASTICSEARCH_URL])
# @generateTsTypes(path=./env.d.ts)
# @defaultRequired=infer
# @defaultSensitive=true
# ---

# @sensitive=false @type=port
API_PORT=8787

# How often the running API syncs every user's recently played tracks. 0 turns it off.
# Spotify only keeps the last 50 plays, so keep this well under a couple of hours.
# @sensitive=false @type=number
SYNC_INTERVAL_MINUTES=30

# Built web app (apps/web/dist) to serve alongside the API on one origin. `pnpm serve` sets
# it; leave empty in development, where Vite serves the app.
# @sensitive=false
WEB_DIST_DIR=

# MusicBrainz requires an identifying User-Agent with contact info.
# @sensitive=false
MUSICBRAINZ_USER_AGENT=replay-crate/0.1 (https://github.com/pixelg/replay-crate)
