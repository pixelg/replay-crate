# API config. Secrets live in the root .env.local.
#
# @import(../../, pick=[SPOTIFY_CLIENT_ID, SPOTIFY_REDIRECT_URI, DATABASE_URL])
# @generateTsTypes(path=./env.d.ts)
# @defaultRequired=infer
# @defaultSensitive=true
# ---

# @sensitive=false @type=port
API_PORT=8787

# AES-GCM key for encrypting Spotify refresh tokens at rest. Needed from M1.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Signs session cookies. Needed from M1. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Bearer token the scheduled GitHub Action sends to POST /api/cron/poll. Needed from M2.
CRON_SECRET=

# Last.fm API key (last.fm/api/account/create). Needed from M4.
LASTFM_API_KEY=

# MusicBrainz requires an identifying User-Agent with contact info.
# @sensitive=false
MUSICBRAINZ_USER_AGENT=replay-crate/0.1 (https://github.com/pixelg/replay-crate)
