{
  "name": "@replay-crate/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#storybook/preview": "./.storybook/preview.tsx"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "e2e:build": "SPOTIFY_CLIENT_ID=e2e-client SPOTIFY_REDIRECT_URI=http://127.0.0.1:4174/callback vite build --outDir dist-e2e --emptyOutDir",
    "e2e:server": "pnpm e2e:build && WEB_DIST_DIR=\"$PWD/dist-e2e\" pnpm --filter @replay-crate/api e2e:server",
    "test:e2e": "playwright test",
    "api-types": "openapi-typescript ../api/openapi.json --output src/test/api.gen.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@replay-crate/api-client": "workspace:*",
    "@replay-crate/core": "workspace:*",
    "@replay-crate/spotify": "workspace:*",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@varlock/vite-integration": "^1.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "openapi-msw": "^2.0.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "shadcn": "^4.21.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "varlock": "^1.20.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
